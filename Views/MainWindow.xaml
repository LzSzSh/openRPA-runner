<Window x:Class="OpenRpaWorkflowLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:OpenRpaWorkflowLauncher.Models"
        mc:Ignorable="d"
        Title="Maxwell麦威数字助手"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F6F7F9" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#687382" />
        <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#ECEDEF" />
        <SolidColorBrush x:Key="RunBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="RunBorderBrush" Color="#15803D" />
        <SolidColorBrush x:Key="ExecuteBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ExecuteBorderBrush" Color="#1D4ED8" />

        <DropShadowEffect x:Key="SelectedShadow"
                          Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.16" />

        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EAEC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDDEE1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecentProjectsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                    <Setter Property="Effect" Value="{StaticResource SelectedShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                    <Setter Property="Effect" Value="{StaticResource SelectedShadow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecentProjectButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EAEC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDDEE1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                                <Setter Property="Effect" Value="{StaticResource SelectedShadow}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource RunBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RunBorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#15803D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#166534" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExecuteButtonStyle" TargetType="Button" BasedOn="{StaticResource RunButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ExecuteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ExecuteBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#991B1B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="BorderBrush" Value="#D7DCE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Running">
                    <Setter Property="Background" Value="#FFF6D9" />
                    <Setter Property="BorderBrush" Value="#E0B84F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Background" Value="#E7F7ED" />
                    <Setter Property="BorderBrush" Value="#5BAE75" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                    <Setter Property="Background" Value="#FDE8E8" />
                    <Setter Property="BorderBrush" Value="#D35B5B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                    <Setter Property="Background" Value="#FFF1DD" />
                    <Setter Property="BorderBrush" Value="#D99A42" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WorkflowRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                    <Setter Property="Background" Value="#FFF6D9" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="办公助手"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,18" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding ShowRecentProjectsCommand}"
                            Style="{StaticResource RecentButtonStyle}"
                            Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="28"
                                  Height="18"
                                  Stretch="None"
                                  Fill="#111111"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M 8 4 L 8 14 L 16 9 Z" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecentExpanded}" Value="True">
                                                <Setter Property="Data" Value="M 5 6 L 17 6 L 11 14 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="项目"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleRecentProjectSearchCommand}"
                            ToolTip="搜索项目"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M15.5,14H14.71L14.43,13.73A6.5,6.5 0 1,0 13.73,14.43L14,14.71V15.5L19.49,20.99L20.99,19.49L15.5,14M9.5,14A4.5,4.5 0 1,1 14,9.5A4.5,4.5 0 0,1 9.5,14Z"
                              Fill="#475569"
                              Width="18"
                              Height="18"
                              Stretch="Uniform" />
                    </Button>
                    </Grid>

                    <StackPanel Margin="0,6,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecentExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBox Text="{Binding RecentProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="34"
                                 Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecentSearchVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ScrollViewer
                                  MaxHeight="456"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentProjectView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RecentProjectItem}">
                                    <Button Command="{Binding DataContext.SelectRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RecentProjectButtonStyle}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>

                <Button Grid.Row="1"
                        Command="{Binding ShowSettingsCommand}"
                        Style="{StaticResource SettingsButtonStyle}"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙"
                                   FontSize="18"
                                   Width="28"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="设置"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid Visibility="{Binding IsHomeVisible}">
                <TextBlock Text="准备开始你的 workflow"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#202124" />
            </Grid>

            <Grid Visibility="{Binding IsSettingsVisible}" Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="设置"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="点击输入框后，直接按键盘设置快捷键；鼠标按键不会被记录。"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,6,0,28" />

                <Grid Grid.Row="2" MaxWidth="820" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="520" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="运行快捷键"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0" />
                    <TextBox x:Name="RunHotkeyBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding RunHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             MinHeight="38"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             Tag="Run"
                             Margin="0,0,0,0" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="清除"
                            Command="{Binding ClearRunHotkeyCommand}"
                            Width="72"
                            Margin="4,0,0,0" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="停止快捷键"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,14,0,0" />
                    <TextBox x:Name="StopHotkeyBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding StopHotkeyText, Mode=OneWay}"
                             IsReadOnly="True"
                             MinHeight="38"
                             Margin="0,14,0,0"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                             Tag="Stop" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="清除"
                            Command="{Binding ClearStopHotkeyCommand}"
                            Width="72"
                            Margin="4,14,0,0" />

                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="3"
                               Text="{Binding HotkeyError}"
                               Foreground="#DC2626"
                               Margin="0,14,0,0" />
                </Grid>

                <Border Grid.Row="3"
                        MaxWidth="820"
                        HorizontalAlignment="Left"
                        Margin="0,32,0,0"
                        Padding="22"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="公司共享工作流目录"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="输入路径后仅保存设置；点击“立即刷新”读取项目。读取完成后会保留在此页面，供你确认结果。执行时直接使用网络路径，不创建本地缓存。"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SharedLibraryFolder, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="38"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="浏览…"
                                    Command="{Binding BrowseSharedLibraryCommand}"
                                    MinWidth="76"
                                    Margin="8,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="立即刷新"
                                    Command="{Binding SyncSharedLibraryCommand}"
                                    Style="{StaticResource ExecuteButtonStyle}"
                                    MinWidth="96"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding SharedLibraryStatus}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

            </Grid>

            <Grid Visibility="{Binding IsWorkflowVisible}" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentProjectName}"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectFolder}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Width="92"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <Border Grid.Column="2"
                            Style="{StaticResource StatusBadgeStyle}"
                            VerticalAlignment="Center"
                            MaxWidth="420">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="搜索 Workflow"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="38" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding VisibleWorkflowCount, StringFormat=显示 {0} 个}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="14,0,10,0" />
                        <Button Grid.Column="3"
                                Content="{Binding RunButtonText}"
                                Command="{Binding RunFirstWorkflowCommand}"
                                Style="{StaticResource RunButtonStyle}"
                                MinWidth="92" />
                        <Button Grid.Column="4"
                                Content="{Binding StopButtonText}"
                                Command="{Binding StopWorkflowCommand}"
                                Style="{StaticResource StopButtonStyle}"
                                MinWidth="92" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding WorkflowView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowStyle="{StaticResource WorkflowRowStyle}"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Workflow"
                                                Binding="{Binding WorkflowName}"
                                                Width="3*" />
                            <DataGridTextColumn Header="Project"
                                                Binding="{Binding ProjectName}"
                                                Width="2*" />
                            <DataGridTextColumn Header="兼容性"
                                                Binding="{Binding CompatibilityStatus}"
                                                Width="1.6*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding CompatibilityDetails}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding LastRunStatus}"
                                                Width="1.5*" />
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:WorkflowItem}">
                                        <Button Content="执行"
                                                Width="82"
                                                Style="{StaticResource ExecuteButtonStyle}"
                                                IsEnabled="{Binding CanRun}"
                                                Command="{Binding DataContext.RunWorkflowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <TabControl Grid.Row="2" Margin="0,16,0,0">
                    <TabItem Header="执行日志">
                        <ListBox x:Name="LogsListBox"
                                 ItemsSource="{Binding Logs}"
                                 BorderBrush="{StaticResource LineBrush}">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="清空"
                                              Command="{Binding ClearLogsCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="扫描警告">
                        <ListBox ItemsSource="{Binding Warnings}" BorderBrush="{StaticResource LineBrush}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
