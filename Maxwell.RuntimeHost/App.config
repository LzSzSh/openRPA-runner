<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- The runtime dynamically loads OpenRPA assemblies. Permit loading them
       when the installed application is located on a trusted UNC share. -->
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
