{
  "manifest_version": 3,
  "name": "Maxwell OpenRPA Browser Bridge",
  "version": "1.0.0",
  "description": "Bundled OpenRPA-compatible browser bridge for Maxwell.",
  "key": "",
  "permissions": [ "tabs", "nativeMessaging", "webNavigation", "downloads", "scripting" ],
  "host_permissions": [ "http://*/*", "https://*/*", "file:///*" ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [ "content.js" ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "OpenRPA16.png",
    "48": "OpenRPA48.png",
    "128": "OpenRPA128.png"
  }
}
