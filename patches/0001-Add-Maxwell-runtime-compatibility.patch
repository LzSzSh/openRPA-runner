diff --git a/OpenRPA.Windows/MaxwellChromeCompatibility.cs b/OpenRPA.Windows/MaxwellChromeCompatibility.cs
new file mode 100644
index 00000000..d16a37b8
--- /dev/null
+++ b/OpenRPA.Windows/MaxwellChromeCompatibility.cs
@@ -0,0 +1,158 @@
+using OpenRPA.Interfaces;
+using OpenRPA.Interfaces.Selector;
+using FlaUI.Core.AutomationElements;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace OpenRPA.Windows
+{
+    /// <summary>
+    /// Runtime-only compatibility for workflows executed by Maxwell's bundled
+    /// Chrome. It never changes selectors saved by the OpenRPA designer.
+    /// </summary>
+    public static class MaxwellChromeCompatibility
+    {
+        private const string EnvironmentVariable = "MAXWELL_WINDOWS_UIA_COMPATIBILITY";
+
+        public static bool IsChromeSelector(WindowsSelector selector)
+        {
+            return selector != null && selector.Count > 0 &&
+                IsEnabled() &&
+                string.Equals(selector[0].processname(), "chrome", StringComparison.OrdinalIgnoreCase);
+        }
+
+        public static void NormalizeSelector(WindowsSelector selector)
+        {
+            if (!IsChromeSelector(selector)) return;
+
+            foreach (SelectorItem item in selector)
+            {
+                SelectorItemProperty className = item.Properties.FirstOrDefault(property =>
+                    property.Enabled && string.Equals(property.Name, "ClassName", StringComparison.OrdinalIgnoreCase));
+                if (className == null || !string.Equals(className.Value, "Chrome_WidgetWin_1", StringComparison.OrdinalIgnoreCase)) continue;
+
+                SelectorItemProperty title = item.Properties.FirstOrDefault(property =>
+                    property.Enabled && string.Equals(property.Name, "Name", StringComparison.OrdinalIgnoreCase));
+                if (title == null) continue;
+
+                title.Enabled = false;
+                Log.Output("MAXWELL_UIA ignored volatile Chrome window title: " + title.Value);
+            }
+        }
+
+        public static bool IsChromeSelector(string selector)
+        {
+            if (!IsEnabled() || string.IsNullOrWhiteSpace(selector)) return false;
+            try { return IsChromeSelector(new WindowsSelector(selector)); }
+            catch { return false; }
+        }
+
+        public static string GetTargetAutomationId(WindowsSelector selector)
+        {
+            if (!IsChromeSelector(selector)) return null;
+            for (var index = selector.Count - 1; index >= 0; index--)
+            {
+                var property = FindEnabledProperty(selector[index], "AutomationId");
+                if (property != null && !string.IsNullOrWhiteSpace(property.Value)) return property.Value;
+            }
+            return null;
+        }
+
+        /// <summary>
+        /// Temporarily relaxes only volatile web attributes on the final selector
+        /// layer. The caller must dispose the returned scope immediately after its
+        /// one fallback lookup so the recorded selector remains unchanged.
+        /// </summary>
+        public static IDisposable BeginStableTargetFallback(WindowsSelectorItem item)
+        {
+            if (!IsEnabled() || item == null) return null;
+            var automationId = FindEnabledProperty(item, "AutomationId");
+            if (automationId == null || string.IsNullOrWhiteSpace(automationId.Value)) return null;
+
+            var states = new List<PropertyState>();
+            foreach (var property in item.Properties.Where(property =>
+                string.Equals(property.Name, "Name", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(property.Name, "ClassName", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(property.Name, "IndexInParent", StringComparison.OrdinalIgnoreCase)))
+            {
+                states.Add(new PropertyState(property, property.Enabled));
+                property.Enabled = false;
+            }
+            return new PropertyRestoreScope(states);
+        }
+
+        public static bool MatchesStableTarget(WindowsSelectorItem recorded, AutomationElement candidate)
+        {
+            if (recorded == null || candidate == null) return false;
+            var automationId = FindEnabledProperty(recorded, "AutomationId");
+            if (automationId == null || string.IsNullOrWhiteSpace(automationId.Value)) return false;
+
+            try
+            {
+                if (!string.Equals(candidate.Properties.AutomationId.ValueOrDefault, automationId.Value, StringComparison.Ordinal)) return false;
+
+                var controlType = FindEnabledProperty(recorded, "ControlType");
+                if (controlType != null && !string.Equals(candidate.Properties.ControlType.ValueOrDefault.ToString(), controlType.Value, StringComparison.OrdinalIgnoreCase)) return false;
+
+                var frameworkId = FindEnabledProperty(recorded, "FrameworkId");
+                if (frameworkId != null && !string.Equals(candidate.Properties.FrameworkId.ValueOrDefault, frameworkId.Value, StringComparison.OrdinalIgnoreCase)) return false;
+
+                // A web framework can append/remove individual CSS classes during
+                // rendering. Keep a class constraint, but accept a stable shared
+                // token after the exact selector has already failed.
+                var className = recorded.Properties.FirstOrDefault(property => string.Equals(property.Name, "ClassName", StringComparison.OrdinalIgnoreCase));
+                if (className != null && !string.IsNullOrWhiteSpace(className.Value))
+                {
+                    var expectedTokens = TokenizeClassName(className.Value);
+                    var actualTokens = TokenizeClassName(candidate.Properties.ClassName.ValueOrDefault);
+                    if (expectedTokens.Count > 0 && !expectedTokens.Any(token => actualTokens.Contains(token))) return false;
+                }
+                return true;
+            }
+            catch (Exception ex)
+            {
+                Log.Output("MAXWELL_UIA fallback-match-exception=" + ex.GetType().Name + "; message=" + ex.Message);
+                return false;
+            }
+        }
+
+        private static SelectorItemProperty FindEnabledProperty(SelectorItem item, string name)
+        {
+            return item == null ? null : item.Properties.FirstOrDefault(property =>
+                property.Enabled && string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase));
+        }
+
+        private static HashSet<string> TokenizeClassName(string value)
+        {
+            return new HashSet<string>((value ?? string.Empty)
+                .Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries), StringComparer.OrdinalIgnoreCase);
+        }
+
+        private sealed class PropertyState
+        {
+            public PropertyState(SelectorItemProperty property, bool enabled)
+            {
+                Property = property;
+                Enabled = enabled;
+            }
+            public SelectorItemProperty Property { get; private set; }
+            public bool Enabled { get; private set; }
+        }
+
+        private sealed class PropertyRestoreScope : IDisposable
+        {
+            private readonly IEnumerable<PropertyState> states;
+            public PropertyRestoreScope(IEnumerable<PropertyState> states) { this.states = states; }
+            public void Dispose()
+            {
+                foreach (var state in states) state.Property.Enabled = state.Enabled;
+            }
+        }
+
+        private static bool IsEnabled()
+        {
+            return string.Equals(Environment.GetEnvironmentVariable(EnvironmentVariable), "1", StringComparison.Ordinal);
+        }
+    }
+}
