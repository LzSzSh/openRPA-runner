+        /// <summary>
+        /// Removes only cache entries that are rooted in, or contain results from,
+        /// a specific desktop process. Maxwell uses this for its isolated Chrome
+        /// instance so a browser navigation cannot leave cross-apartment UIA
+        /// objects behind without flushing caches for Excel and other applications.
+        /// </summary>
+        public static int ClearCacheForProcessName(string processName)
+        {
+            if (string.IsNullOrWhiteSpace(processName)) return 0;
+            var removed = 0;
+            if (!System.Threading.Monitor.TryEnter(cache_lock, 1000)) return removed;
+            try
+            {
+                var items = MatchCache.Where(item => CacheItemContainsProcess(item, processName)).ToList();
+                foreach (var item in items)
+                {
+                    MatchCache.Remove(item);
+                    removed++;
+                }
+            }
+            finally
+            {
+                System.Threading.Monitor.Exit(cache_lock);
+            }
+            return removed;
+        }
+        private static bool CacheItemContainsProcess(MatchCacheItem item, string processName)
+        {
+            if (item == null) return false;
+            if (ElementHasProcessName(item.Root, processName)) return true;
+            if (item.Result == null) return false;
+            foreach (var element in item.Result)
+            {
+                if (ElementHasProcessName(element, processName)) return true;
+            }
+            return false;
+        }
+        private static bool ElementHasProcessName(AutomationElement element, string processName)
+        {
+            if (element == null) return false;
+            try
+            {
+                var processId = element.Properties.ProcessId.ValueOrDefault;
+                if (processId <= 0) return false;
+                using (var process = System.Diagnostics.Process.GetProcessById(processId))
+                {
+                    return string.Equals(process.ProcessName, processName, StringComparison.OrdinalIgnoreCase);
+                }
+            }
+            catch
+            {
+                return false;
+            }
+        }
