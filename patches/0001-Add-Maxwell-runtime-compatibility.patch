+        // Maxwell ships a portable Chromium browser inside RuntimeHost's runtime
+        // directory. Prefer that browser explicitly so a workflow with
+        // Browser="chrome" does not depend on the user's installed Chrome or on
+        // Windows' default-browser setting. The normal system chrome.exe lookup
+        // remains only as a compatibility fallback for a non-Maxwell host.
+        private static void StartChrome(string url, string profilepath)
+        {
+            string maxwellProfile = Environment.GetEnvironmentVariable("MAXWELL_BROWSER_PROFILE");
+            string effectiveProfile = string.IsNullOrWhiteSpace(maxwellProfile) ? profilepath : maxwellProfile;
+            string extensionDirectory = Environment.GetEnvironmentVariable("MAXWELL_BROWSER_EXTENSION");
+            // RuntimeHost normally passes this location through its child
+            // environment. Some legacy workflow execution paths construct a
+            // separate AppDomain and do not retain that variable. The private
+            // Maxwell extension is deliberately mirrored to this fixed local
+            // directory, so use it as a deterministic fallback instead of
+            // silently launching Chrome without the automation extension.
+            if (string.IsNullOrWhiteSpace(extensionDirectory))
+            {
+                extensionDirectory = Path.Combine(
+                    Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                    "Maxwell", "OpenRpaExtension");
+            }
+            string extensionArgument = string.IsNullOrWhiteSpace(extensionDirectory) || !Directory.Exists(extensionDirectory)
+                ? string.Empty
+                : " --disable-extensions-except=\"" + extensionDirectory + "\" --load-extension=\"" + extensionDirectory + "\"";
+            string arguments = string.IsNullOrEmpty(effectiveProfile)
+                ? "\"" + url + "\""
+                : "--user-data-dir=\"" + effectiveProfile + "\"  \"" + url + "\"";
+            arguments = "--no-first-run --no-default-browser-check --disable-default-apps --allow-file-access-from-files" + extensionArgument + " " + arguments;
+
+            try
+            {
+                string diagnosticDirectory = Path.Combine(
+                    Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Maxwell");
+                Directory.CreateDirectory(diagnosticDirectory);
+                File.AppendAllText(Path.Combine(diagnosticDirectory, "browser-launch.log"),
+                    DateTime.Now.ToString("O") + " extension=" + extensionDirectory +
+                    "; exists=" + Directory.Exists(extensionDirectory) +
+                    "; arguments=" + arguments + Environment.NewLine);
+            }
+            catch { }
+
+            // RuntimeHost may itself live on an SMB share.  Its chrome-portable
+            // directory is only the distribution seed; launching Chrome from
+            // there makes Chromium child processes fail silently on some VMs.
+            // MaxwellRuntimeRunner has already mirrored the browser locally,
+            // so always prefer that explicit local path.
+            string configuredChrome = Environment.GetEnvironmentVariable("MAXWELL_BUNDLED_CHROME");
+            if (!string.IsNullOrEmpty(configuredChrome) && File.Exists(configuredChrome))
+            {
+                System.Diagnostics.Process.Start(configuredChrome, arguments);
+                return;
+            }
+
+            string runtimeDirectory = AppDomain.CurrentDomain.BaseDirectory;
+            string[] bundledCandidates = new[]
+            {
+                Path.Combine(runtimeDirectory, "chrome-portable", "Chrome", "chrome.exe"),
+                Path.Combine(runtimeDirectory, "chrome-portable", "chrome.exe")
+            };
 
+            string bundledChrome = bundledCandidates.FirstOrDefault(File.Exists);
+            if (!string.IsNullOrEmpty(bundledChrome))
+            {
+                System.Diagnostics.Process.Start(bundledChrome, arguments);
+                return;
             }
+
+            System.Diagnostics.Process.Start("chrome.exe", arguments);
         }
