+        private static bool TryGetBrowserUrl(string filename, out string browserUrl)
+        {
+            browserUrl = null;
+            if (string.IsNullOrWhiteSpace(filename)) return false;
+
+            string target = filename.Trim().Trim('\"');
+            if (Uri.TryCreate(target, UriKind.Absolute, out Uri uri) &&
+                (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
+            {
+                browserUrl = target;
+                return true;
+            }
+
+            string name = Path.GetFileName(target).Trim();
+            string normalizedName = Path.GetFileNameWithoutExtension(name).Trim();
+            string[] browserNames = { "chrome", "google chrome", "chromium", "chromium-browser", "msedge", "microsoft edge", "edge", "firefox", "brave", "opera" };
+            return browserNames.Any(browserName => string.Equals(normalizedName, browserName, StringComparison.OrdinalIgnoreCase));
+        }
